// Stock audio impl blobs (P-era ABI); override the AOSP-built impls which
// write S-layout audio_config into the P-layout stock primary HAL stack.
// The 32-bit impl is additionally binary-patched: StreamIn::updateSinkMetadata
// and StreamOut::updateSourceMetadata are no-oped (bx lr) because the P blob's
// audio_stream_in/out lack those callback pointers.
cc_prebuilt_library_shared {
    name: "qin_audio4_impl_override",
    stem: "android.hardware.audio@4.0-impl",
    vendor: true,
    compile_multilib: "both",
    multilib: {
        lib32: { srcs: ["proprietary/vendor/lib/hw/android.hardware.audio@4.0-impl.so"] },
        lib64: { srcs: ["proprietary/vendor/lib64/hw/android.hardware.audio@4.0-impl.so"] },
    },
    relative_install_path: "hw",
    strip: { none: true },
    check_elf_files: false,
    overrides: ["android.hardware.audio@4.0-impl"],
}

cc_prebuilt_library_shared {
    name: "qin_audio_effect4_impl_override",
    stem: "android.hardware.audio.effect@4.0-impl",
    vendor: true,
    compile_multilib: "both",
    multilib: {
        lib32: { srcs: ["proprietary/vendor/lib/hw/android.hardware.audio.effect@4.0-impl.so"] },
        lib64: { srcs: ["proprietary/vendor/lib64/hw/android.hardware.audio.effect@4.0-impl.so"] },
    },
    relative_install_path: "hw",
    strip: { none: true },
    check_elf_files: false,
    overrides: ["android.hardware.audio.effect@4.0-impl"],
}

